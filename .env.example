# bgkit environment configuration
# Copy to .env and customize. The .env file is gitignored.

# WandB API key for experiment tracking
WANDB_API_KEY=

# Root data directory (repos, descriptions, structural, models, crawl DB)
# Default: ./data
# For external drive: /mnt/external/bgkit-data
DATA_DIR=./data

# Checkpoint directory (training checkpoints and registry)
# Default: ./checkpoints
# For external drive: /mnt/external/bgkit-checkpoints
CHECKPOINT_DIR=./checkpoints
