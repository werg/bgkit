# BgKIT Data Preprocessing Dockerfile (CPU-only)
FROM python:3.12-slim

WORKDIR /workspace/bgkit

# System deps for git processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libgit2-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install uv

COPY pyproject.toml uv.lock* ./

# Install without torch (CPU preprocessing doesn't need GPU)
RUN uv sync --frozen --no-group torch || uv sync --no-group torch

COPY src/ src/
COPY configs/ configs/
COPY scripts/ scripts/

RUN uv pip install --no-deps -e .

ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python"]
